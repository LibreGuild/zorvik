{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zorvik",
  "mainBinaryName": "zorvik-desktop",
  "version": "0.2.1",
  "identifier": "org.libreguild.zorvik",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zorvik",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "API client and network testing toolkit",
    "longDescription": "Zorvik is a desktop API client and network testing toolkit: HTTP, GraphQL, gRPC, WebSocket, SSE, TCP/UDP, load tests, mock servers and a command-line runner (zorvik), with Git-friendly collections. AI agents can control it over MCP.",
    "copyright": "Copyright \u00a9 2026 The Zorvik contributors",
    "publisher": "Libre Guild",
    "homepage": "https://github.com/LibreGuild/zorvik",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MzlFNkIzRjY4ODJBRDUKUldUVktvajJzK1k1V09KTXhuSmlmWG9ocWl6V2xDR25LM3lTc0wzMjZ4VStOd2hGMzRJODBnMG0K",
      "endpoints": [
        "https://github.com/LibreGuild/zorvik/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
